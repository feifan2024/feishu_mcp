# nginx HTTPS 反向代理样例：终止 TLS 并转发到本机 feishu-mcp (127.0.0.1:3000)
# 用途：MCP 远程客户端要求 https:// 地址时，用 nginx 挂证书最方便（certbot 自动续期）。
# 安装：复制到 /etc/nginx/conf.d/feishu-mcp.conf 后 nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name mcp.example.com;
    # certbot 续期用
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name mcp.example.com;

    # 证书路径按实际修改（certbot: /etc/letsencrypt/live/mcp.example.com/）
    ssl_certificate     /etc/ssl/certs/mcp.example.com.pem;
    ssl_certificate_key /etc/ssl/private/mcp.example.com.key;

    # MCP 端点
    location /mcp {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # 长响应（大文档读取）与连接保持
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;

        # 流式响应（如未来启用 SSE）所需
        proxy_set_header Connection "";
        chunked_transfer_encoding on;
    }
}
