# feishu-mcp 环境变量样例（systemd EnvironmentFile 格式）
# 复制到服务器后按需修改；含敏感 token，注意文件权限（chmod 600）

# HTTP 模式必填：Bearer 鉴权 token（生成：openssl rand -hex 32，多个用逗号分隔）
MCP_HTTP_TOKEN=change-me-to-a-long-random-token

MCP_TRANSPORT=http
# 反代场景绑 127.0.0.1；无反代直连绑 0.0.0.0
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000

# 可选：服务内置 HTTPS（配置证书路径后直接以 https 启动；用 nginx 反代则留空）
# MCP_HTTP_TLS_CERT=/etc/ssl/certs/your-domain.pem
# MCP_HTTP_TLS_KEY=/etc/ssl/private/your-domain.key

# lark-cli 相关
# LARK_CLI_PATH=/usr/local/bin/lark-cli
LARK_IDENTITY=user
LARK_TIMEOUT_MS=120000
# LARK_PROFILE=
